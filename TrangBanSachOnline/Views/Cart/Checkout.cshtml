@model CheckoutModel
@{
    ViewData["Title"] = "Checkout";
}

<h2>Thanh toán</h2>
<form asp-action="Checkout">
    <div class="py-2">
        <label asp-for="Name">Họ và tên*</label>
        <input type="text" class="form-control" asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="py-2">
        <label asp-for="Email">Email*</label>
        <input type="text" class="form-control" asp-for="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>

    </div>

    <div class="py-2">
        <label asp-for="PhoneNumber">Số điện thoại*</label>
        <input type="text" class="form-control" asp-for="PhoneNumber" />
        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
    </div>


    <div class="py-2">
        <label asp-for="Address">Địa chỉ*</label>
        <textarea class="form-control" asp-for="Address" rows="5"> </textarea>
        <span asp-validation-for="Address" class="text-danger"></span>
    </div>

    <div class="py-2">
        <span class="mr-2">COD*</span>
        <select asp-for="PaymentMethod" class="form-control">
            <option value="">Chọn phương thức thanh toán</option>
            @foreach (var method in Enum.GetValues(typeof(TrangBanSachOnline.Constants.PaymentMethod)))
            {
                <option value="@method.ToString()">@method.ToString()</option>

            }
        </select>
        <span asp-validation-for="PaymentMethod" class="text-danger"></span>
    </div>

    <div class="py-2">
        <button type="submit" c class="btn btn-info">Tiếp theo</button>

    </div>
</form>