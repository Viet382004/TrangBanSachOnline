@model ShoppingCart
@{
    ViewData["Title"] = "GetUserCart";
}

<div style="width=90%; margin=auto">
    <h2>Giỏ hàng của bạn</h2>
@if (Model != null &&Model.CartDetails!=null && Model.CartDetails.Count >0)
    {
        <table class="table table-striped">
            <tr>
                <th>Sản phẩm</th>
                <th>Ảnh</th>
                <th>Thể loại</th>
                <th>Giá</th>
                <th>Tổng tiền</th>
                <th>Hành động</th>
            </tr>
            @foreach (var item in Model.CartDetails)
            {
                <tr>
                    <td>@item.Book.BookName</td>
                    <td>
                        @if (!string.IsNullOrEmpty(@item.Book.Image))
                        {
                            <img src="/Images/NoImage.png"  width="80" height="100" />
                        }
                        else
                        {
                            <img src="/Images/@item.Book.Image" width="80" height="100" />

                        }
                    </td>
                    <td>@item.Book.Genre.GenreName</td>
                    <td>@item.Book.Price X @item.Quantity</td>
                    <td>@(item.Book.Price* item.Quantity)</td>
                    <td>
                        <a class="btn btn-info" href="/Cart/AddItem?bookId=@item.BookId&&redirect=1">+</a>
                        <a class="btn btn-info" href="/Cart/RemoveItem?bookId=@item.BookId">-</a>
                    </td>
                </tr>
            }
        </table>
        <div class="my-2">
            <h5>Tổng tiền (VND):</h5>
            @(Model.CartDetails.Sum(cd => cd.Book.Price * cd.Quantity))
        </div>
        <div class="my-2">
            <a class="btn btn-primary" href="#">Thanh Toán</a>
        </div>
    }
    else
    {
        <h5>Bạn không có sản phẩm nào trong giỏ hàng</h5>
    }
}
</div>

