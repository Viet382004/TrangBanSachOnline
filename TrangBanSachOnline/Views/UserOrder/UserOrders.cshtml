@model IEnumerable<Order>
@{
}
<div style="width:100%" class="mt-2">
    <a href="/Identity/Account/Manage" class="btn btn-primary my-2">Trở về</a>

    <h4>Đơn hàng của tôi</h4>
    @if (Model != null && Model.Count() > 0)
    {
        <table class="table table-striped">
            <tr>
                <th>Ngày tạo đơn hàng</th>
                <th>Trạng thái đơn hàng</th>
            </tr>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.CreatedDate.ToString("dd-MM-yyyy")</td>
                    <td>@order.OderStatus.StatusName</td>
                </tr>
                @if (order.OderDetail != null && order.OderDetail.Count > 0)
                {
                    <tr>
                        <td>
                            <table class="table table-striped">
                                <tr>
                                    <td>
                                        Tổng :
                                    </td>
                                    <td>
                                        @(order.OderDetail.Select(item => item.Book.Price * item.Quantity).Sum())

                                    </td>
                                </tr>
                                <tr>
                                    <th>Tên sách</th>
                                    <th>Ảnh</th>
                                    <th>Thể loại</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                                @foreach (var item in order.OderDetail)
                                {
                                    <tr>
                                        <td>@item.Book.BookName</td>
                                        <td>
                                            @if (string.IsNullOrEmpty(item.Book.Image))
                                            {
                                                <img src="/images/NoImage.png" style="width:80px;height:100px" />
                                            }
                                            else
                                            {
                                                <img src="/images/@item.Book.Image" style="width:80px;height:100px" />
                                            }
                                        </td>
                                        <td>@item.Book.Genre.GenreName</td>
                                        <td>@item.Book.Price X @item.Quantity</td>
                                        <td> @(item.Book.Price* item.Quantity) </td>
                                    </tr>
                                }
                            </table>
                        </td>
                    </tr>
                }
            }
        </table>

    }
    else
    {
        <h5>Bạn không có đơn hàng nào !</h5>
    }
</div>



