@model IEnumerable<Order>

@{
    ViewData["Title"] = "Đơn hàng của tôi";
}

<div class="container my-4">
    <a href="/Identity/Account/Manage" class="btn btn-outline-primary mb-3">
        <i class="bi bi-arrow-left"></i> Trở về
    </a>

    <h3 class="fw-bold mb-4 text-primary">
        <i class="bi bi-box-seam"></i> Đơn hàng của tôi
    </h3>

    @if (Model != null && Model.Any())
    {
        @foreach (var order in Model)
        {
            <div class="card mb-4 border-0 shadow-sm rounded-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center">
                    <div>
                        <strong>Ngày tạo đơn hàng:</strong> @order.CreatedDate.ToString("dd-MM-yyyy")
                    </div>
                    <div>
                        <strong>Trạng thái:</strong>
                        <span class="badge
                                    @(order.OderStatus.StatusName == "Delivered" ? "bg-success" :
                                                            order.OderStatus.StatusName == "Cancelled" ? "bg-danger" :
                                                            order.OderStatus.StatusName == "Pending" ? "bg-warning text-dark" :
                                                            "bg-secondary")">
                    @order.OderStatus.StatusName
                </span>
            </div>
        </div>

                <div class="card-body">
            @if (order.OderDetail != null && order.OderDetail.Any())
                    {
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Tên sách</th>
                                    <th>Ảnh</th>
                                    <th>Thể loại</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in order.OderDetail)
                                {
                                    <tr>
                                        <td>@item.Book.BookName</td>
                                        <td>
                                            <img src="@(string.IsNullOrEmpty(item.Book.Image)
                                 ? "/images/NoImage.png"
                                 : "/images/" + item.Book.Image)"
                                 style="width:80px;height:100px"
                                 class="rounded shadow-sm" />
                        </td>
                        <td>@item.Book.Genre.GenreName</td>
                        <td>@item.Quantity</td>
                        <td>@String.Format("{0:N0}", item.Book.Price) ₫</td>
                        <td class="fw-bold text-success">
                            @String.Format("{0:N0}", item.Book.Price * item.Quantity) ₫
                        </td>
                    </tr>
                                        }
                            </tbody>
                        </table>

                        <div class="text-end mt-3">
                            <h5 class="fw-bold">
                                Tổng tiền:
                                <span class="text-danger">
                                    @String.Format("{0:N0}", order.OderDetail.Sum(item => item.Book.Price * item.Quantity)) ₫
                                </span>
                            </h5>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5">
            <img src="/Images/Empty_Cart.jpg" width="150" class="mb-3" />
            <h5 class="text-muted">Bạn không có đơn hàng nào!</h5>
            <a href="/Home/Index" class="btn btn-primary mt-3">Tiếp tục mua sắm</a>
        </div>
    }
</div>
