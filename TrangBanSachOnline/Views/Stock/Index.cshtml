@model IEnumerable<StockDisplayModel>
@{
    //Layout = "_AdminLayout";
}
<h2>Quản lý kho hàng</h2>

<form asp-action="Index" method="get" class="my-2 d-flex gap-2">
    <input type="text" name="sTerm" class="form-control w-25" placeholder="Tìm sách ..." />
    <button type="submit" class="btn btn-primary">Tìm</button>
    <a asp-action="Index" asp-controller="Stock" class="btn btn-primary">Xóa</a>
</form>

<table class="table table-bordered">
    <tr>
        <th>Tên sách</th>
        <th>Số lượng trong kho</th>
        <th>Hành động</th>
    </tr>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.BookName</td>
            <td>@item.Quantity</td>
            <td>
                <a asp-action="ManangeStock" asp-controller="Stock" asp-route-bookId="@item.BookId" class="btn btn-info">Cập nhật kho</a>
            </td>
        </tr>
    }
</table>
