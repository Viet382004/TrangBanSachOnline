@model BookDisplayModel

@{

}

<div class="my-2">

    <!-- Form tìm kiếm -->
    <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center  mb-4">


        <div class="col-12">
            <label class="visually-hidden" for="genreId">Thể loại</label>
            <select class="form-select" id="genreId" name="genreId">
                <option selected>Chọn thể loại</option>
                @foreach (var genre in Model.Genres)
                {
                    <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>

                }

            </select>
        </div>
        <div class="col-12">
            <label class="visually-hidden" for="sTerm">Tìm kiếm bởi tên</label>
            <div class="input-group">
                <div class="input-group-text"></div>
                <input type="text" class="form-control" value="@Model.STerm" id="sTerm" name="sTerm" placeholder="Tìm kiếm bới tên">
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
            <a href="/Home/Index" class="btn btn-dark">Làm mới</a>
        </div>
    </form>

    <!-- Danh sách sách -->
    <div class="w-100 d-flex flex-wrap justify-content-start">
        @foreach (var book in Model.Books)
        {
            <div class="card mx-3 mb-4 shadow-sm d-flex flex-column" style="width: 16rem;">
                <div style="height: 250px; overflow: hidden;">
                    @if (string.IsNullOrEmpty(book.Image))
                    {
                        <img src="/Images/NoImage.png" class="card-img-top" alt="No Image">
                    }
                    else
                    {
                        <img src="/Images/@book.Image" class="card-img-top" alt="@book.BookName">
                    }
                </div>

                <div class="card-body d-flex flex-column">
                    <h5 class="card-title text-truncate" title="@book.BookName">@book.BookName</h5>

                    <p class="card-text mb-3 flex-grow-1">
                        <b>Thể loại:</b> @book.GenreName <br>
                        <b>Tác giả:</b> @book.AuthorName<br>
                        <b>Giá:</b> @book.Price.ToString("C0", new System.Globalization.CultureInfo("vi-VN"))<br />
                        <b>Số lượng:</b> @book.Quantity

                    </p>
                    @if (book.Quantity > 0)
                    {
                        <button type="button" onclick="add(@book.Id)" class="btn btn-primary mt-auto w-100">
                            Thêm vào giỏ hàng
                        </button>
                    }
                    else
                    {
                        <span style="border: 1px solid;padding: 5px 8px;color: red;border-radius: 5px;">
                            Hết hàng
                        </span>
                    }
                </div>
            </div>
        }
    </div>


</div>

@section Scripts {
    <script>
        async function add(bookId) {
             var usernameEl = document.getElementById("username");
        if(usernameEl==null){
            window.location.href = "/Identity/Account/Login";
          //var username=usernameEl.innerText;
          //  if(username.length<1){
          //      window.location.href="/Identity/Account/Login";
          //  }
        }
            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    cartCountEl.innerHTML = result;
                    window.location.href = "#cartCount";
                }
            }
            catch (err) {
                console.log(err);
            }
        }
    </script>
}
