@model BookDisplayModel
 
@{
    ViewData["Title"] = "Home Page";
}

<div class="my-2">

    <!-- Form tìm kiếm -->
    <form asp-action="Index" class="row row-cols-lg-auto g-3 align-items-center  mb-4">


        <div class="col-12">
            <label class="visually-hidden" for="genreId">Thể loại</label>
            <select class="form-select" id="genreId" name="genreId">
                <option selected>Chọn thể loại</option>
                @foreach (var genre in Model.Genres)
                {
                    <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>

                }

            </select>
        </div>
        <div class="col-12">
            <label class="visually-hidden" for="sTerm">Tìm kiếm bởi tên</label>
            <div class="input-group">
                <div class="input-group-text"></div>
                <input type="text" class="form-control" value="@Model.STerm" id="sTerm" name="sTerm" placeholder="Tìm kiếm bới tên">
            </div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Tìm kiếm</button>
        </div>
    </form>

    <!-- Danh sách sách -->
    <div class="w-100 d-flex flex-wrap ">
        @foreach (var book in Model.Books)
        {
            <div class="card mx-2 mb-4 shadow-sm" style="width: 16rem;">
                @if (string.IsNullOrEmpty(book.Image))
                {
                    <img src="https://via.placeholder.com/256x180?text=No+Image" class="card-img-top" alt="No Image" />
                }
                else
                {
                    <img src="/Images/@book.Image" class="card-img-top" alt="@book.BookName" />
                }
                <div class="card-body">
                    <h5 class="card-title">@book.BookName</h5>
                    <p class="card-text">
                        <strong>Thể loại:</strong>@book.GenreName <br />
                        <strong>Tác giả:</strong> @book.AuthorName<br />
                        <strong>Giá:</strong> @book.Price.ToString("C0")

                    </p>
                    <a href="#" class="btn btn-primary w-100">Thêm vào giỏ hàng</a>
                </div>
            </div>
        }
    </div>

</div>
