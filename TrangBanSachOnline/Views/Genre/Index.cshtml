@model IEnumerable<Genre>
@{
    //Layout = "_AdminLayout";
}

<h2>Quản lý thể loại sách</h2>

<a asp-action="AddGenre" asp-controller="Genre" class="btn btn-primary">Thêm mới</a>

<table class="table table-striped my-2">
    <tr>
        <th>Thể loại</th>
        <th>Hành động</th>
    </tr>

    @foreach (var genre in Model)
    {
        <tr>
            <td>@genre.GenreName</td>
            <td>
                <a asp-action="UpdateGenre" asp-controller="Genre" 
                asp-route-id="@genre.Id" class="btn btn-success">Chỉnh sửa</a>
                <a asp-action="DeleteGenre" asp-controller="Genre" 
                asp-route-id="@genre.Id" class="btn btn-danger" onclick="return window.confirm('Bạn có chắc muốn xóa ?')">Xóa</a>
            </td>
        </tr>
    }
</table>
