@model GenreDTO

@{
    // ViewData["Title"] = "AddGenre";
}

<h1>Thêm mới thể loại</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <a asp-action="Index" asp-controller="Genre" class="btn btn-primary">Trở lại</a>
        <form asp-action="AddGenre">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="GenreName" class="control-label"></label>
                <input asp-for="GenreName" class="form-control" />
                <span asp-validation-for="GenreName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Thêm mới</button>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Trở về danh sách</a>
</div>

